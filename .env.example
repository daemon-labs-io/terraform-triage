# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is the only version that lives in version control.
#
# Two things to update before running anything:
#   1. AWS_* values — the facilitator will post the three credentials in
#      the workshop Slack channel; paste them into the AWS_* fields below.
#   2. PARTICIPANT_ID — set this to your GitHub username (lowercase).
#
# AWS sessions are short-lived (typically 1h); if you start seeing
# `ExpiredToken` errors, ask the facilitator for a refresh in Slack.

AWS_ACCESS_KEY_ID=ASIAEXAMPLEEXAMPLEEX
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_SESSION_TOKEN=IQoJb3JpZ2luX2VjEXAMPLESESSIONTOKENVALUE
AWS_DEFAULT_REGION=eu-west-2

# Your GitHub username, lowercase. Used to namespace your Terraform state
# (s3://.../participants/<id>/terraform.tfstate) and your AWS resource names
# (triage-<id>-web, etc.) so multiple participants can run in parallel.
PARTICIPANT_ID=replace-me
